# ## 🔀 Section 2.5-2.7: GraphRAG Implementation
# ### ผสม Vector Search + Knowledge Graph

# %%
from qdrant_client import QdrantClient

# Reconnect to Qdrant from Day 1
qdrant = QdrantClient(host="localhost", port=6333)
EMBED_MODEL = "bge-m3"
COLLECTION_NAME = "workshop_day1"

def get_embedding(text: str) -> List[float]:
    response = ollama.embeddings(model=EMBED_MODEL, prompt=text)
    return response["embedding"]

# %%
class GraphRAG:
    """
    GraphRAG: Combining Vector Search + Knowledge Graph
    
    Based on PPLUS production GraphRAG-rs approach:
    1. Vector search → get relevant chunks
    2. Extract entities from query
    3. Graph expand → get related entities & context
    4. Merge vector + graph context
    5. Generate answer with enriched context
    """
    
    def __init__(self, qdrant_client, neo4j_kg: Neo4jKnowledgeGraph,
                 collection: str, llm_model: str = LLM_MODEL):
        self.qdrant = qdrant_client
        self.kg = neo4j_kg
        self.collection = collection
        self.llm = llm_model
    
    def vector_search(self, query: str, top_k: int = 3) -> List[Dict]:
        """Step 1: Dense vector search"""
        query_vec = get_embedding(query)
        results = self.qdrant.search(
            collection_name=self.collection,
            query_vector=query_vec,
            limit=top_k,
            with_payload=True
        )
        return [
            {"text": r.payload["text"], "score": r.score}
            for r in results
        ]
    
    def extract_query_entities(self, query: str) -> List[str]:
        """Step 2: Extract key entities from query for graph lookup"""
        prompt = f"""จากคำถาม: "{query}"
        
ดึงคำสำคัญที่เป็น entities (ไม่เกิน 3 คำ)
ตอบเป็น JSON array เท่านั้น เช่น: ["ประกัน", "OPD"]"""
        
        try:
            resp = ollama.chat(
                model=self.llm,
                messages=[{"role": "user", "content": prompt}],
                options={"temperature": 0}
            )
            import re
            match = re.search(r'\[.*?\]', resp["message"]["content"])
            if match:
                return json.loads(match.group())
        except:
            pass
        return []
    
    def graph_expand(self, entities: List[str]) -> str:
        """Step 3: Get graph context for extracted entities"""
        contexts = []
        for entity in entities:
            # Search for matching nodes in Neo4j
            cypher = """
            MATCH (n:Entity)
            WHERE n.text CONTAINS $search
            OPTIONAL MATCH (n)-[r]-(connected:Entity)
            RETURN n.text as entity, type(r) as relation, connected.text as connected
            LIMIT 10
            """
            try:
                results = self.kg.query(cypher, search=entity)
                if results:
                    entity_context = [f"[{entity}]"]
                    for r in results:
                        if r.get("relation") and r.get("connected"):
                            entity_context.append(
                                f"  --{r['relation']}--> {r['connected']}"
                            )
                    contexts.append("\n".join(entity_context))
            except:
                pass
        
        return "\n\n".join(contexts) if contexts else ""
    
    def query(self, question: str, top_k: int = 3) -> Dict:
        """
        GraphRAG query pipeline
        
        Returns comprehensive answer using both vector + graph context
        """
        # Step 1: Vector search
        vector_results = self.vector_search(question, top_k)
        vector_context = "\n\n".join([r["text"] for r in vector_results])
        
        # Step 2: Extract entities from query
        entities = self.extract_query_entities(question)
        
        # Step 3: Graph expand
        graph_context = self.graph_expand(entities)
        
        # Step 4: Merge contexts
        merged_context = f"""=== เอกสารที่เกี่ยวข้อง ===
{vector_context}

=== ความสัมพันธ์จาก Knowledge Graph ===
{graph_context if graph_context else "ไม่พบข้อมูลใน Knowledge Graph"}"""
        
        # Step 5: Generate answer
        system = """คุณเป็น AI ผู้ช่วยที่ตอบคำถามเกี่ยวกับนโยบายบริษัท
ใช้ทั้งเอกสารและ Knowledge Graph ในการตอบ
ตอบเป็นภาษาไทย กระชับ ชัดเจน"""
        
        prompt = f"""{merged_context}

คำถาม: {question}

ตอบโดยอ้างอิงจากข้อมูลด้านบน"""
        
        try:
            resp = ollama.chat(
                model=self.llm,
                messages=[
                    {"role": "system", "content": system},
                    {"role": "user", "content": prompt}
                ],
                options={"temperature": 0.1}
            )
            answer = resp["message"]["content"]
        except Exception as e:
            answer = f"Error generating answer: {e}"
        
        return {
            "question": question,
            "answer": answer,
            "vector_results": vector_results,
            "entities": entities,
            "graph_context": graph_context,
            "merged_context": merged_context
        }

