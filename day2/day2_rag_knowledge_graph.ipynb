# ## 🗄️ Section 2.4: Neo4j Setup & Cypher
# ### จัดเก็บ Knowledge Graph ใน Neo4j

# %%
class Neo4jKnowledgeGraph:
    """Neo4j Knowledge Graph manager"""
    
    def __init__(self, uri: str, user: str, password: str):
        self.driver = GraphDatabase.driver(uri, auth=(user, password))
        rprint("[green]✅ Neo4j KG initialized[/green]")
    
    def close(self):
        self.driver.close()
    
    def clear_db(self):
        """ลบทุกอย่างใน database (ใช้ระวัง!)"""
        with self.driver.session() as session:
            session.run("MATCH (n) DETACH DELETE n")
        rprint("[yellow]🗑️ Database cleared[/yellow]")
    
    def create_entity(self, node_id: str, label: str, text: str, 
                       entity_type: str, **props):
        """สร้าง entity node"""
        with self.driver.session() as session:
            session.run(
                f"""
                MERGE (n:{label} {{id: $node_id}})
                SET n.text = $text,
                    n.entity_type = $entity_type,
                    n += $props
                """,
                node_id=node_id, text=text,
                entity_type=entity_type, props=props
            )
    
    def create_relationship(self, from_id: str, to_id: str, 
                             rel_type: str, **props):
        """สร้าง relationship ระหว่าง nodes"""
        # Sanitize rel_type for Cypher (uppercase, no spaces)
        rel_type = rel_type.upper().replace(" ", "_").replace("-", "_")
        
        with self.driver.session() as session:
            session.run(
                f"""
                MATCH (a {{id: $from_id}})
                MATCH (b {{id: $to_id}})
                MERGE (a)-[r:{rel_type}]->(b)
                SET r += $props
                """,
                from_id=from_id, to_id=to_id, props=props
            )
    
    def load_kg(self, kg_data: Dict):
        """Load extracted KG data into Neo4j"""
        for node in kg_data["nodes"]:
            self.create_entity(
                node_id=node["id"],
                label="Entity",
                text=node["text"],
                entity_type=node["type"],
                description=node.get("description", "")
            )
        
        for edge in kg_data["edges"]:
            rel_type = edge["relation"].replace(" ", "_")
            self.create_relationship(
                from_id=edge["from_id"],
                to_id=edge["to_id"],
                rel_type=rel_type
            )
        
        rprint(f"[green]✅ Loaded KG: {len(kg_data['nodes'])} nodes, {len(kg_data['edges'])} edges[/green]")
    
    def query(self, cypher: str, **params) -> List[Dict]:
        """Execute Cypher query"""
        with self.driver.session() as session:
            result = session.run(cypher, **params)
            return [dict(record) for record in result]
    
    def get_entity_context(self, entity_text: str, depth: int = 2) -> str:
        """
        Get graph context for an entity
        Returns all connected nodes within 'depth' hops
        Used in GraphRAG to expand context
        """
        cypher = f"""
        MATCH (start {{text: $text}})
        CALL apoc.path.subgraphAll(start, {{
            maxLevel: {depth}
        }})
        YIELD nodes, relationships
        RETURN nodes, relationships
        """
        
        # Simple version without APOC
        cypher_simple = """
        MATCH (start {text: $text})-[r*1..2]-(connected)
        RETURN start.text as start, type(r[-1]) as relation, connected.text as connected
        LIMIT 20
        """
        
        try:
            results = self.query(cypher_simple, text=entity_text)
            
            if not results:
                return f"Entity '{entity_text}' found but no connections"
            
            context_parts = [f"Entity: {entity_text}"]
            for r in results:
                context_parts.append(
                    f"  → [{r.get('relation', '?')}] → {r.get('connected', '?')}"
                )
            
            return "\n".join(context_parts)
        
        except Exception as e:
            return f"Graph context error: {e}"

