# ## 🔍 Section 2.2: Entity Extraction
# ### ดึง Entities จากเอกสารด้วย NER + LLM

# %%
# Method 1: Rule-based NER with PyThaiNLP
from pythainlp.tag import chunk, pos_tag
from pythainlp.tokenize import word_tokenize

def extract_entities_rule_based(text: str) -> List[Dict]:
    """
    Extract entities using PyThaiNLP POS tagging
    ดึง NOUN phrases และ named entities
    """
    tokens = word_tokenize(text, engine="newmm")
    tagged = pos_tag(tokens, engine="perceptron")
    
    entities = []
    current_entity = []
    current_type = None
    
    for word, pos in tagged:
        # NOUN (NCMN), Proper noun (NPRP)
        if pos in ["NCMN", "NPRP", "VACT"]:
            current_entity.append(word)
        else:
            if current_entity:
                entity_text = "".join(current_entity)
                if len(entity_text) > 1:
                    entities.append({
                        "text": entity_text,
                        "type": "ENTITY",
                        "method": "rule_based"
                    })
                current_entity = []
    
    return entities

# Test
test_sentence = "พนักงานบริษัท PPLUS มีสิทธิได้รับประกันสุขภาพจาก MTL"
