# ## 📊 Section 2.1: Knowledge Graph Basics
# ### Nodes, Edges, Properties

# %%
# Knowledge Graph คือ graph ที่มี:
# - Nodes (vertices): entities เช่น Person, Organization, Policy
# - Edges (relationships): ความสัมพันธ์ระหว่าง nodes
# - Properties: attributes ของ nodes/edges

# ตัวอย่าง: Employee Benefits Knowledge Graph
# (Person:พนักงาน) -[RECEIVES]-> (Benefit:ประกันสุขภาพ)
# (Benefit:ประกันสุขภาพ) -[PROVIDED_BY]-> (Company:MTL)
# (Benefit:ประกันสุขภาพ) -[COVERS]-> (Service:OPD)
# (Service:OPD) -[HAS_LIMIT]-> (Amount:1000_บาท)

# Simple in-memory graph for understanding
class SimpleKnowledgeGraph:
    """Simple KG implementation for learning concepts"""
    
    def __init__(self):
        self.nodes = {}   # id -> {"label": str, "properties": dict}
        self.edges = []   # [{"from": id, "to": id, "type": str, "properties": dict}]
    
    def add_node(self, node_id: str, label: str, **properties):
        self.nodes[node_id] = {"label": label, "properties": properties}
        return node_id
    
    def add_edge(self, from_id: str, to_id: str, rel_type: str, **properties):
        self.edges.append({
            "from": from_id, "to": to_id,
            "type": rel_type, "properties": properties
        })
    
    def get_neighbors(self, node_id: str, rel_type: str = None) -> List[str]:
        neighbors = []
        for edge in self.edges:
            if edge["from"] == node_id:
                if rel_type is None or edge["type"] == rel_type:
                    neighbors.append(edge["to"])
        return neighbors
    
    def describe(self):
        rprint(f"[blue]Nodes: {len(self.nodes)}, Edges: {len(self.edges)}[/blue]")

