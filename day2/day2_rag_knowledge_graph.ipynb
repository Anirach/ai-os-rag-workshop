# ## 🕸️ Section 2.3: Graph Construction
# ### สร้าง Knowledge Graph จาก extracted entities

# %%
def build_kg_from_document(chunks: List[str], model: str = LLM_MODEL) -> Dict:
    """
    Process document chunks และสร้าง Knowledge Graph
    
    Returns:
        {"nodes": list, "edges": list, "stats": dict}
    """
    from tqdm import tqdm
    
    all_entities = []
    all_relationships = []
    entity_map = {}  # text -> node_id
    
    rprint(f"[blue]Processing {len(chunks)} chunks...[/blue]")
    
    for i, chunk in enumerate(tqdm(chunks[:10], desc="Extracting")):  # Limit for demo
        result = extract_entities_llm(chunk, model)
        
        for entity in result.get("entities", []):
            text = entity["text"]
            if text not in entity_map:
                node_id = f"node_{len(entity_map)}"
                entity_map[text] = node_id
                all_entities.append({
                    "id": node_id,
                    "text": text,
                    "type": entity.get("type", "ENTITY"),
                    "description": entity.get("description", ""),
                    "source_chunk": i
                })
        
        for rel in result.get("relationships", []):
            from_text = rel.get("from", "")
            to_text = rel.get("to", "")
            relation = rel.get("relation", "RELATED_TO")
            
            if from_text in entity_map and to_text in entity_map:
                all_relationships.append({
                    "from_id": entity_map[from_text],
                    "from_text": from_text,
                    "to_id": entity_map[to_text],
                    "to_text": to_text,
                    "relation": relation,
                    "source_chunk": i
                })
    
    rprint(f"[green]✅ Extracted {len(all_entities)} entities, {len(all_relationships)} relationships[/green]")
    
    return {
        "nodes": all_entities,
        "edges": all_relationships,
        "stats": {
            "total_nodes": len(all_entities),
            "total_edges": len(all_relationships),
            "chunks_processed": min(len(chunks), 10)
        }
    }

