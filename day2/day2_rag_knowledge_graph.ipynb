# Test GraphRAG
try:
    graph_rag = GraphRAG(qdrant, neo4j_kg, COLLECTION_NAME)
    
    test_questions = [
        "ประกันสุขภาพครอบคลุมอะไรบ้างและมีวงเงินเท่าไหร่?",
        "พนักงานมีสิทธิลาป่วยกี่วัน?",
    ]
    
    for question in test_questions:
        rprint(f"\n{'='*60}")
        rprint(f"[bold blue]❓ {question}[/bold blue]")
        
        result = graph_rag.query(question)
        
        rprint(f"\n[bold green]✅ Answer:[/bold green]")
        rprint(result["answer"])
        
        rprint(f"\n[dim]Entities extracted: {result['entities']}[/dim]")
        if result["graph_context"]:
            rprint(f"[dim]Graph context:\n{result['graph_context'][:300]}...[/dim]")

except Exception as e:
    rprint(f"[red]GraphRAG error: {e}[/red]")
    rprint("[yellow]Make sure Day 1 Qdrant data is indexed[/yellow]")

