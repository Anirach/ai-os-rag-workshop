# ### Requirements:
#
# **Functional:**
# - ✅ ตอบคำถาม HR จาก Knowledge Base (RAG)
# - ✅ ค้นหา entity relationships จาก Knowledge Graph
# - ✅ Multi-turn conversation (จำ context ได้)
# - ✅ Tool calling (ลา, คำนวณวัน, ค้นหาเอกสาร)
#
# **Technical:**
# - ✅ Ollama (local LLM: qwen3:8b)
# - ✅ Qdrant (vector search)
# - ✅ Neo4j (knowledge graph)
# - ✅ Python agent framework
#
# **Evaluation:**
# - Hit Rate@3 >= 70%
# - Answer relevancy >= 60%
# - Response time < 10 seconds
#
# ### Deliverable:
# Python script หรือ Notebook ที่รัน demo ได้

# %%
class EnterpriseHRAssistant:
    """
    Capstone: Full Enterprise HR AI Assistant
    
    Combines:
    - Tool-Use Agent (Day 3)
    - GraphRAG retrieval (Day 2)
    - Thai NLP pipeline (Day 1)
    - Multi-turn memory
    """
    
    def __init__(self, qdrant_client, neo4j_driver=None, 
                 model: str = LLM_MODEL):
        self.qdrant = qdrant_client
        self.neo4j = neo4j_driver
        self.model = model
        self.memory = AgentMemory(max_turns=10)
        
        # Register tools
        self.tools = [
            Tool(
                name="search_knowledge_base",
                description="ค้นหาข้อมูลจากเอกสาร HR",
                func=lambda q, n=3: search_hr_documents(q, n),
                parameters={
                    "q": {"type": "string", "description": "คำค้นหา"},
                    "n": {"type": "integer", "description": "จำนวนผลลัพธ์"}
                }
            ),
            Tool(
                name="get_leave_info",
                description="ดูข้อมูลนโยบายการลา",
                func=get_leave_policy,
                parameters={
                    "leave_type": {"type": "string", "description": "ประเภทการลา"}
                }
            ),
            Tool(
                name="count_working_days",
                description="นับวันทำงานระหว่างสองวันที่",
                func=calculate_leave_days,
                parameters={
                    "start_date": {"type": "string", "description": "วันเริ่ม YYYY-MM-DD"},
                    "end_date": {"type": "string", "description": "วันสิ้นสุด YYYY-MM-DD"}
                }
            )
        ]
        
        self.tool_map = {t.name: t for t in self.tools}
    
    def chat(self, user_message: str) -> str:
        """Main chat interface"""
        self.memory.add("user", user_message)
        
        system = """คุณเป็น HR Assistant ของบริษัท PPLUS
ช่วยพนักงานเกี่ยวกับนโยบาย สวัสดิการ และการลา
ใช้ tools หาข้อมูลก่อนตอบเสมอ ตอบภาษาไทย"""
        
        messages = [
            {"role": "system", "content": system},
            *self.memory.get_messages()
        ]
        
        ollama_tools = [t.to_ollama_tool() for t in self.tools]
        
        for _ in range(3):  # Max 3 tool calls
            resp = ollama.chat(
                model=self.model,
                messages=messages,
                tools=ollama_tools,
                options={"temperature": 0.1}
            )
            
            msg = resp["message"]
            tool_calls = msg.get("tool_calls", [])
            
            if not tool_calls:
                answer = msg["content"]
                self.memory.add("assistant", answer)
                return answer
            
            messages.append({"role": "assistant", **msg})
            
            for call in tool_calls:
                name = call["function"]["name"]
                args = call["function"]["arguments"]
                if isinstance(args, str):
                    args = json.loads(args)
                
                result = self.tool_map[name].run(**args) if name in self.tool_map else "Unknown tool"
                messages.append({"role": "tool", "content": result, "name": name})
        
        return "ขออภัย ไม่สามารถตอบได้ในขณะนี้"

