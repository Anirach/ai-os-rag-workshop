# Demo Capstone
rprint(Panel(
    "[bold]🏆 Capstone Demo: Enterprise HR Assistant[/bold]\n\n"
    "Multi-turn conversation with tool use",
    title="Demo"
))

assistant = EnterpriseHRAssistant(qdrant)

demo_conversation = [
    "สวัสดีครับ อยากทราบเรื่องการลาป่วย",
    "ถ้าลาตั้งแต่วันที่ 10 ถึง 14 มีนาคม 2026 จะใช้ลาไปกี่วัน?",
    "แล้วถ้าอยากลากิจเพิ่มอีก 2 วัน เหลือสิทธิ์ลาเท่าไหร่?",
]

for msg in demo_conversation:
    rprint(f"\n[bold blue]👤 User:[/bold blue] {msg}")
    try:
        answer = assistant.chat(msg)
        rprint(f"[bold green]🤖 Assistant:[/bold green] {answer[:300]}")
    except Exception as e:
        rprint(f"[red]Error: {e}[/red]")

