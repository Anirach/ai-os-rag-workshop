# ## 📊 Section 3.6: Evaluation with RAGAS
# ### วัดคุณภาพ RAG ด้วย Metrics

# %%
# RAGAS (RAG Assessment) metrics:
# - Faithfulness: คำตอบ match กับ context ไหม?
# - Answer Relevancy: คำตอบตรงคำถามไหม?
# - Context Precision: retrieved docs relevant ไหม?
# - Context Recall: ดึงข้อมูลที่ต้องการได้ครบไหม?

# Simple evaluation without full RAGAS (for demo)
def evaluate_rag_simple(
    rag_fn: Callable,
    test_cases: List[Dict]
) -> Dict:
    """
    Simple RAG evaluation
    
    test_cases format:
    [{"question": str, "expected": str, "ground_truth": str}]
    """
    results = []
    
    for case in test_cases:
        q = case["question"]
        expected_keywords = case.get("expected_keywords", [])
        
        # Get RAG answer
        try:
            if hasattr(rag_fn, "chat"):
                result = rag_fn.chat(q)
                answer = result["answer"]
            else:
                answer = str(rag_fn(q))
        except Exception as e:
            answer = f"Error: {e}"
        
        # Score: keyword overlap
        answer_lower = answer.lower()
        matched = sum(1 for kw in expected_keywords if kw.lower() in answer_lower)
        score = matched / len(expected_keywords) if expected_keywords else 0
        
        results.append({
            "question": q,
            "answer": answer[:200],
            "expected_keywords": expected_keywords,
            "matched": matched,
            "score": score
        })
    
    avg_score = sum(r["score"] for r in results) / len(results) if results else 0
    
    return {
        "results": results,
        "avg_score": avg_score,
        "total_cases": len(results)
    }

