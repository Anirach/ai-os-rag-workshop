# ## 🔍 Section 3.3: RAG Agent
# ### Agent + Knowledge Base Retrieval

# %%
class RAGAgent:
    """
    RAG Agent: combines Agent reasoning with RAG retrieval
    Can answer questions from Knowledge Base
    """
    
    def __init__(self, qdrant_client, collection: str, 
                 model: str = LLM_MODEL, embed_model: str = EMBED_MODEL):
        self.qdrant = qdrant_client
        self.collection = collection
        self.model = model
        self.embed_model = embed_model
        self.memory = AgentMemory()
    
    def retrieve(self, query: str, top_k: int = 5) -> List[Dict]:
        """Retrieve relevant chunks"""
        vec = get_embedding_local(query)
        results = self.qdrant.search(
            collection_name=self.collection,
            query_vector=vec,
            limit=top_k,
            with_payload=True
        )
        return [{"text": r.payload["text"], "score": r.score} for r in results]
    
    def generate(self, question: str, context: str) -> str:
        """Generate answer with context"""
        system = """คุณเป็น HR Assistant ที่ตอบคำถามจากฐานข้อมูลบริษัท
ตอบจากข้อมูลที่ให้มาเท่านั้น ไม่ต้องอ้างอิงนอกเหนือจากนี้
ตอบเป็นภาษาไทย กระชับ ชัดเจน"""
        
        prompt = f"""ข้อมูลจากฐานความรู้:
{context}

คำถาม: {question}

ตอบโดยอ้างอิงจากข้อมูลด้านบน"""
        
        messages = [
            {"role": "system", "content": system},
            *self.memory.get_messages(),
            {"role": "user", "content": prompt}
        ]
        
        resp = ollama.chat(
            model=self.model,
            messages=messages,
            options={"temperature": 0.1}
        )
        return resp["message"]["content"]
    
    def chat(self, question: str) -> Dict:
        """Multi-turn RAG chat"""
        # Retrieve
        docs = self.retrieve(question)
        context = "\n\n".join([d["text"] for d in docs])
        
        # Generate
        answer = self.generate(question, context)
        
        # Update memory
        self.memory.add("user", question)
        self.memory.add("assistant", answer)
        
        return {
            "question": question,
            "answer": answer,
            "retrieved_docs": len(docs),
            "sources": docs[:2]
        }

