# %%
class AgentRouter:
    """
    Routes queries to appropriate specialist agents
    Based on PPLUS production system with 5 agent modes
    """
    
    ROUTING_RULES = {
        "hr": ["ลา", "สวัสดิการ", "ประกัน", "เงินเดือน", "พนักงาน", "กองทุน",
               "leave", "insurance", "salary", "benefit", "hr"],
        "finance": ["เบิก", "ใบเสร็จ", "invoice", "งบ", "จัดซื้อ", 
                    "budget", "payment", "tax", "reimbursement"],
        "safety": ["ความปลอดภัย", "อุบัติเหตุ", "ไฟไหม้", "PPE", "safety", "accident"],
        "it": ["network", "server", "IT", "computer", "wifi", "อินเทอร์เน็ต"],
        "general": []  # Fallback
    }
    
    def __init__(self, agents: Dict[str, Any]):
        self.agents = agents
    
    def detect_mode(self, query: str) -> str:
        """Detect which agent should handle this query"""
        query_lower = query.lower()
        
        for mode, keywords in self.ROUTING_RULES.items():
            if mode == "general":
                continue
            if any(kw in query_lower for kw in keywords):
                return mode
        
        return "general"
    
    def route(self, query: str) -> Dict:
        """Route query to appropriate agent"""
        mode = self.detect_mode(query)
        rprint(f"[cyan]🔀 Routing to: {mode} agent[/cyan]")
        
        if mode in self.agents:
            agent = self.agents[mode]
            if hasattr(agent, "run"):
                answer = agent.run(query)
            elif hasattr(agent, "chat"):
                result = agent.chat(query)
                answer = result["answer"]
            else:
                answer = "Agent not properly configured"
        else:
            answer = f"ขออภัย ยังไม่มี {mode} agent"
        
        return {
            "query": query,
            "routed_to": mode,
            "answer": answer
        }

