# ## 🔧 Section 3.2: Tool-Use Agents
# ### Function calling with Ollama

# %%
class HRAgent:
    """
    HR Assistant Agent with Tool Use
    
    Uses ReAct pattern: Think → Act → Observe → Answer
    Implements function calling via Ollama
    """
    
    def __init__(self, tools: List[Tool], model: str = LLM_MODEL):
        self.tools = tools
        self.tool_map = {t.name: t for t in tools}
        self.model = model
        self.memory = AgentMemory(max_turns=5)
        
        # System prompt
        self.system = """คุณเป็น HR Assistant ของบริษัท PPLUS Visions
คุณช่วยพนักงานเกี่ยวกับ:
- นโยบายการลา สวัสดิการ
- ระเบียบบริษัท
- คำนวณวันลา

ใช้ tools ที่มีในการหาข้อมูลก่อนตอบเสมอ
ตอบเป็นภาษาไทย สุภาพ ชัดเจน"""
    
    def run(self, user_message: str, max_iterations: int = 3) -> str:
        """
        Run agent with tool calling loop
        
        Args:
            user_message: คำถามจากผู้ใช้
            max_iterations: จำนวน tool-call loop สูงสุด
        
        Returns:
            Final answer string
        """
        # Add to memory
        self.memory.add("user", user_message)
        
        # Prepare messages
        messages = [
            {"role": "system", "content": self.system},
            *self.memory.get_messages()
        ]
        
        # Ollama tool format
        ollama_tools = [t.to_ollama_tool() for t in self.tools]
        
        for iteration in range(max_iterations):
            # Call LLM
            try:
                response = ollama.chat(
                    model=self.model,
                    messages=messages,
                    tools=ollama_tools,
                    options={"temperature": 0.1}
                )
            except Exception as e:
                return f"LLM error: {e}"
            
            msg = response["message"]
            
            # Check if tool calls requested
            tool_calls = msg.get("tool_calls", [])
            
            if not tool_calls:
                # Final answer
                answer = msg["content"]
                self.memory.add("assistant", answer)
                return answer
            
            # Execute tool calls
            messages.append({"role": "assistant", **msg})
            
            for call in tool_calls:
                tool_name = call["function"]["name"]
                tool_args = call["function"]["arguments"]
                
                if isinstance(tool_args, str):
                    tool_args = json.loads(tool_args)
                
                rprint(f"[cyan]🔧 Tool: {tool_name}({tool_args})[/cyan]")
                
                # Execute
                if tool_name in self.tool_map:
                    result = self.tool_map[tool_name].run(**tool_args)
                else:
                    result = f"Unknown tool: {tool_name}"
                
                rprint(f"[dim]   Result: {result[:100]}...[/dim]")
                
                # Add tool result to messages
                messages.append({
                    "role": "tool",
                    "content": result,
                    "name": tool_name
                })
        
        # Max iterations reached
        return "ขออภัย ไม่สามารถหาข้อมูลที่ต้องการได้ กรุณาติดต่อ HR โดยตรง"

