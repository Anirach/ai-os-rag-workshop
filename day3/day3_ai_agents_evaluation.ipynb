# Define tools for our HR Agent
def get_embedding_local(text: str) -> List[float]:
    resp = ollama.embeddings(model=EMBED_MODEL, prompt=text)
    return resp["embedding"]

def search_hr_documents(query: str, top_k: int = 3) -> str:
    """Search HR documents using vector search"""
    try:
        query_vec = get_embedding_local(query)
        results = qdrant.search(
            collection_name=COLLECTION_NAME,
            query_vector=query_vec,
            limit=top_k,
            with_payload=True
        )
        
        if not results:
            return "ไม่พบข้อมูลที่เกี่ยวข้อง"
        
        texts = [f"[{i+1}] {r.payload['text']}" for i, r in enumerate(results)]
        return "\n\n".join(texts)
    
    except Exception as e:
        return f"Search error: {e}"

def get_leave_policy(leave_type: str) -> str:
    """Get specific leave policy information"""
    policies = {
        "ป่วย": "ลาป่วยได้ 30 วันต่อปี โดยได้รับเงินเดือนปกติ ลาเกิน 3 วันต้องมีใบรับรองแพทย์",
        "กิจ": "ลากิจได้ 3 วันต่อปี โดยได้รับเงินเดือนปกติ ต้องแจ้งล่วงหน้าอย่างน้อย 1 วัน",
        "คลอด": "ลาคลอดได้ 98 วัน โดยได้รับเงินเดือน 45 วัน",
        "พักร้อน": "วันหยุดพักผ่อนประจำปี 10 วันต่อปี",
    }
    
    for key, policy in policies.items():
        if key in leave_type:
            return policy
    
    return "กรุณาระบุประเภทการลา: ป่วย, กิจ, คลอด, พักร้อน"

def calculate_leave_days(start_date: str, end_date: str) -> str:
    """Calculate number of working days between two dates"""
    from datetime import datetime, timedelta
    
    try:
        start = datetime.strptime(start_date, "%Y-%m-%d")
        end = datetime.strptime(end_date, "%Y-%m-%d")
        
        # Count working days (Mon-Fri)
        working_days = 0
        current = start
        while current <= end:
            if current.weekday() < 5:  # Monday = 0, Friday = 4
                working_days += 1
            current += timedelta(days=1)
        
        return f"วันทำงานระหว่าง {start_date} ถึง {end_date}: {working_days} วัน"
    
    except ValueError:
        return "รูปแบบวันที่ไม่ถูกต้อง ใช้ YYYY-MM-DD"

