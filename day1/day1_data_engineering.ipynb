    rprint("\n[blue]Cosine Similarity Matrix:[/blue]")
    for i, t1 in enumerate(texts_to_compare):
        for j, t2 in enumerate(texts_to_compare):
            if i < j:
                sim = cosine_similarity(embeddings[i], embeddings[j])
                rprint(f"  '{t1[:20]}' vs '{t2[:20]}': [bold]{sim:.4f}[/bold]")
