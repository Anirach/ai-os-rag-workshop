# ## ✂️ Section 1.3: Chunking Strategies
# ### แบ่ง Document เป็น Chunks

# %%
from langchain.text_splitter import (
    RecursiveCharacterTextSplitter,
    CharacterTextSplitter
)

# %% 
# Strategy 1: Fixed-size chunks
def fixed_chunking(text: str, chunk_size: int = 500, overlap: int = 50) -> List[str]:
    """แบ่ง text เป็น chunks ขนาดคงที่"""
    chunks = []
    for i in range(0, len(text), chunk_size - overlap):
        chunk = text[i:i + chunk_size]
        if chunk.strip():
            chunks.append(chunk)
    return chunks

# %%
# Strategy 2: Recursive Character Splitter (แนะนำสำหรับภาษาไทย)
def recursive_chunking(text: str, chunk_size: int = 500, overlap: int = 100) -> List[str]:
    """
    ใช้ RecursiveCharacterTextSplitter พร้อม Thai separators
    แบ่งตาม: paragraph → sentence → word
    """
    # Thai-aware separators
    separators = [
        "\n\n",      # Paragraph
        "\n",        # Line
        "。",        # Japanese/Chinese period (common in Thai docs)
        ".",         # Period
        " ",         # Space
        ""           # Character
    ]
    
    splitter = RecursiveCharacterTextSplitter(
        chunk_size=chunk_size,
        chunk_overlap=overlap,
        separators=separators,
        length_function=len,
        is_separator_regex=False
    )
    
    chunks = splitter.split_text(text)
    return chunks

# %%
# Compare strategies
