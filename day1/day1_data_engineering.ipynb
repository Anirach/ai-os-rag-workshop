# ## 🔀 Section 1.6: Hybrid Search
# ### ผสม Dense Vector Search + BM25 (Sparse)

# %%
from rank_bm25 import BM25Okapi

class HybridSearcher:
    """
    Hybrid search combining Dense (vector) + Sparse (BM25)
    ใช้ RRF (Reciprocal Rank Fusion) สำหรับ merge results
    
    Based on PPLUS production GraphRAG-rs approach
    """
    
    def __init__(self, chunks: List[str], collection_name: str):
        self.chunks = chunks
        self.collection_name = collection_name
        
        # Build BM25 index with Thai tokenization
        tokenized_corpus = [
            tokenize_thai_text(chunk) for chunk in chunks
        ]
        self.bm25 = BM25Okapi(tokenized_corpus)
        rprint(f"[green]✅ BM25 index built: {len(chunks)} documents[/green]")
    
    def bm25_search(self, query: str, top_k: int = 10) -> List[Dict]:
        """BM25 sparse search"""
        query_tokens = tokenize_thai_text(query)
        scores = self.bm25.get_scores(query_tokens)
        
        # Get top-k indices
        top_indices = np.argsort(scores)[::-1][:top_k]
        
        return [
            {
                "rank": i + 1,
                "chunk_id": int(idx),
                "score": float(scores[idx]),
                "text": self.chunks[idx]
            }
            for i, idx in enumerate(top_indices)
            if scores[idx] > 0
        ]
    
    def dense_search(self, query: str, top_k: int = 10) -> List[Dict]:
        """Dense vector search via Qdrant"""
        results = vector_search(query, self.collection_name, top_k)
        return [
            {**r, "rank": i + 1}
            for i, r in enumerate(results)
        ]
    
    def rrf_fusion(self, dense_results: List[Dict], 
                   bm25_results: List[Dict], k: int = 60) -> List[Dict]:
        """
        Reciprocal Rank Fusion (RRF)
        score = Σ 1/(k + rank_i)
        """
        scores = {}
        
        # Dense results
        for r in dense_results:
            cid = r["chunk_id"]
            scores[cid] = scores.get(cid, 0) + 1 / (k + r["rank"])
        
        # BM25 results
        for r in bm25_results:
            cid = r["chunk_id"]
            scores[cid] = scores.get(cid, 0) + 1 / (k + r["rank"])
        
        # Sort by fused score
        sorted_ids = sorted(scores.items(), key=lambda x: x[1], reverse=True)
        
        return [
            {
                "chunk_id": cid,
                "rrf_score": score,
                "text": self.chunks[cid] if cid < len(self.chunks) else ""
            }
            for cid, score in sorted_ids
        ]
    
    def search(self, query: str, top_k: int = 5) -> List[Dict]:
        """Hybrid search: combine dense + BM25 with RRF"""
        dense = self.dense_search(query, top_k=10)
        sparse = self.bm25_search(query, top_k=10)
        fused = self.rrf_fusion(dense, sparse)
        return fused[:top_k]

# %%
# Initialize hybrid searcher
try:
    searcher = HybridSearcher(all_chunks, COLLECTION_NAME)
    
    # Compare Dense vs Hybrid
    query = "วันหยุดพักผ่อนประจำปีกี่วัน"
    
    rprint(f"\n[bold blue]🔍 Query:[/bold blue] '{query}'")
    
    dense_results = searcher.dense_search(query, top_k=3)
    rprint(f"\n[cyan]Dense-only results:[/cyan]")
    for r in dense_results:
        rprint(f"  Score: {r['score']:.4f} | {r['text'][:100]}...")
    
    hybrid_results = searcher.search(query, top_k=3)
    rprint(f"\n[green]Hybrid (Dense + BM25) results:[/green]")
    for r in hybrid_results:
        rprint(f"  RRF: {r['rrf_score']:.4f} | {r['text'][:100]}...")

except Exception as e:
    rprint(f"[red]Hybrid search error: {e}[/red]")

# %% [markdown]
# ---
# ## 🤖 Section 1.7: Basic RAG Pipeline
# ### ครบวงจร: Query → Retrieve → Generate

# %%
def rag_query(question: str, collection_name: str, 
              top_k: int = 3, model: str = LLM_MODEL) -> Dict:
    """
    Basic RAG Pipeline
    
    Flow: Question → Embed → Search → Build Prompt → LLM → Answer
    
    Args:
        question: คำถามจากผู้ใช้
        collection_name: Qdrant collection ที่จะค้นหา
        top_k: จำนวน chunks ที่ retrieve
        model: Ollama LLM model
    
    Returns:
        {"answer": str, "sources": list, "context": str}
    """
    
    # Step 1: Retrieve relevant chunks
    results = vector_search(question, collection_name, top_k)
    context_chunks = [r["text"] for r in results]
    context = "\n\n---\n\n".join(context_chunks)
    
    # Step 2: Build prompt (Thai-optimized)
    system_prompt = """คุณเป็นผู้ช่วย AI ที่ตอบคำถามเกี่ยวกับนโยบายบริษัท
ตอบคำถามโดยอ้างอิงจากข้อมูลที่ให้มาเท่านั้น
หากไม่มีข้อมูลเพียงพอ ให้บอกว่าไม่ทราบ
ตอบเป็นภาษาไทย กระชับ ชัดเจน"""

    user_prompt = f"""ข้อมูลอ้างอิง:
{context}

คำถาม: {question}

กรุณาตอบโดยอ้างอิงจากข้อมูลด้านบนเท่านั้น"""
    
    # Step 3: Generate answer with Ollama
    response = ollama.chat(
        model=model,
        messages=[
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        options={"temperature": 0.1}  # Low temp for factual answers
    )
    
    answer = response["message"]["content"]
    
    return {
        "question": question,
        "answer": answer,
        "sources": results,
        "context": context
    }

# %%
# Test RAG pipeline
test_questions = [
    "พนักงานมีสิทธิลาป่วยได้กี่วันต่อปี?",
    "ประกันสุขภาพครอบคลุมอะไรบ้าง?",
    "กองทุนสำรองเลี้ยงชีพบริษัทสมทบเท่าไหร่?",
]

for question in test_questions:
    rprint(f"\n{'='*60}")
    rprint(f"[bold blue]❓ {question}[/bold blue]")
    
    try:
        result = rag_query(question, COLLECTION_NAME)
        rprint(f"\n[bold green]✅ Answer:[/bold green]")
        rprint(result["answer"])
        
        rprint(f"\n[dim]Retrieved {len(result['sources'])} chunks[/dim]")
        for i, src in enumerate(result["sources"][:2], 1):
            rprint(f"[dim]  [{i}] Score: {src['score']:.3f} | {src['text'][:80]}...[/dim]")
    
    except Exception as e:
        rprint(f"[red]RAG failed: {e}[/red]")

