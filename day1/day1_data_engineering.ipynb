# Semantic search
def vector_search(query: str, collection_name: str, 
                  top_k: int = 5) -> List[Dict]:
    """
    ค้นหาด้วย semantic similarity
    
    Args:
        query: คำถามที่ต้องการค้นหา
        collection_name: ชื่อ Qdrant collection
        top_k: จำนวนผลลัพธ์
    
    Returns:
        List of {"score": float, "text": str, "metadata": dict}
    """
    # Embed query
    query_vector = get_embedding(query)
    
    # Search
    results = qdrant.search(
        collection_name=collection_name,
        query_vector=query_vector,
        limit=top_k,
        with_payload=True
    )
    
    return [
        {
            "score": r.score,
            "text": r.payload["text"],
            "source": r.payload.get("source", "unknown"),
            "chunk_id": r.payload.get("chunk_id", -1)
        }
        for r in results
    ]

# Test search
