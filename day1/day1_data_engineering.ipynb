# %%
# Create collection
def create_collection(collection_name: str, dim: int = EMBED_DIM):
    """สร้าง Qdrant collection สำหรับเก็บ embeddings"""
    
    # Delete if exists
    try:
        qdrant.delete_collection(collection_name)
        rprint(f"[yellow]🗑️ Deleted existing collection: {collection_name}[/yellow]")
    except:
        pass
    
    # Create new
    qdrant.create_collection(
        collection_name=collection_name,
        vectors_config=VectorParams(
            size=dim,
            distance=Distance.COSINE  # Best for text similarity
        )
    )
    rprint(f"[green]✅ Created collection: {collection_name} (dim={dim})[/green]")

create_collection(COLLECTION_NAME)

# %%
# Index documents: Embed chunks and store in Qdrant
def index_documents(chunks: List[str], collection_name: str, 
                     source: str = "employee_handbook") -> int:
    """
    Embed chunks และ index เข้า Qdrant
    
    Returns: number of indexed documents
    """
    from tqdm import tqdm
    
    points = []
    for i, chunk in enumerate(tqdm(chunks, desc="Indexing")):
        # Skip very short chunks
        if len(chunk.strip()) < 20:
            continue
        
        # Generate embedding
        try:
            embedding = get_embedding(chunk)
        except Exception as e:
            rprint(f"[yellow]Skipping chunk {i}: {e}[/yellow]")
            continue
        
        # Create Qdrant point
        point = PointStruct(
            id=str(uuid.uuid4()),
            vector=embedding,
            payload={
                "text": chunk,
                "source": source,
                "chunk_id": i,
                "char_count": len(chunk)
            }
        )
        points.append(point)
        
        # Upload in batches of 50
        if len(points) >= 50:
            qdrant.upsert(collection_name=collection_name, points=points)
            points = []
    
    # Upload remaining
    if points:
        qdrant.upsert(collection_name=collection_name, points=points)
    
    # Get count
    count = qdrant.count(collection_name=collection_name).count
    rprint(f"[green]✅ Indexed {count} chunks into '{collection_name}'[/green]")
    return count

# Run indexing
