# ## 🔢 Section 1.4: Embedding Generation
# ### สร้าง Vector Embeddings ด้วย bge-m3

# %%
def get_embedding(text: str, model: str = EMBED_MODEL) -> List[float]:
    """
    สร้าง embedding สำหรับ text หนึ่งชิ้น
    
    Args:
        text: Input text (Thai/English)
        model: Ollama model name (default: bge-m3)
    
    Returns:
        Vector of floats (1024 dimensions for bge-m3)
    """
    response = ollama.embeddings(model=model, prompt=text)
    return response["embedding"]

def batch_embeddings(texts: List[str], model: str = EMBED_MODEL, 
                     batch_size: int = 32) -> List[List[float]]:
    """
    สร้าง embeddings แบบ batch เพื่อประสิทธิภาพ
    """
    from tqdm import tqdm
    all_embeddings = []
    
    for i in tqdm(range(0, len(texts), batch_size), desc="Embedding"):
        batch = texts[i:i + batch_size]
        batch_embs = [get_embedding(text, model) for text in batch]
        all_embeddings.extend(batch_embs)
    
    return all_embeddings

