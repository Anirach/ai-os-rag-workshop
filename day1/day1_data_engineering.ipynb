# %%
# Strategy 3: Semantic chunking (paragraph-aware)
def semantic_chunking(text: str) -> List[Dict]:
    """
    แบ่งตาม semantic units (sections, paragraphs)
    ดีที่สุดสำหรับ structured documents
    """
    import re
    chunks = []
    
    # Split by section headers (Thai patterns)
    sections = re.split(r'\n(?=บทที่|ข้อที่|หมวด|\d+\.\d+)', text)
    
    for i, section in enumerate(sections):
        section = section.strip()
        if len(section) > 50:  # Skip very short sections
            # Find section header
            first_line = section.split('\n')[0] if '\n' in section else ""
            chunks.append({
                "chunk_id": i,
                "header": first_line,
                "content": section,
                "char_count": len(section)
            })
    
    return chunks

semantic = semantic_chunking(SAMPLE_TEXT)
rprint(f"[blue]Semantic chunking:[/blue] {len(semantic)} chunks")
for chunk in semantic[:3]:
    rprint(f"  [{chunk['chunk_id']}] {chunk['header'][:50]}... ({chunk['char_count']} chars)")

