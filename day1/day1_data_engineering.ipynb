# %%
def tokenize_thai_text(text: str, engine: str = "newmm") -> List[str]:
    """
    Tokenize Thai text and remove stopwords
    
    Args:
        text: Input Thai text
        engine: Tokenization engine (newmm recommended for speed)
    
    Returns:
        List of meaningful tokens
    """
    # Normalize first
    text = normalize_thai(text)
    
    # Tokenize
    tokens = word_tokenize(text, engine=engine)
    
    # Filter: remove stopwords, single chars, non-Thai/English
    stop_words = thai_stopwords()
    meaningful_tokens = [
        t for t in tokens
        if t.strip()
        and t not in stop_words
        and len(t) > 1
    ]
    
    return meaningful_tokens

# Test
