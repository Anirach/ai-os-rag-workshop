# Read PDF with PyMuPDF (fitz)
import fitz  # PyMuPDF

def load_pdf(file_path: str) -> List[Dict]:
    """
    โหลด PDF และ return list of pages พร้อม metadata
    
    Returns:
        List of {"page": int, "text": str, "source": str}
    """
    doc = fitz.open(file_path)
    pages = []
    
    for page_num, page in enumerate(doc):
        text = page.get_text("text")  # Extract plain text
        if text.strip():  # Skip empty pages
            pages.append({
                "page": page_num + 1,
                "text": text,
                "source": Path(file_path).name
            })
    
    doc.close()
    rprint(f"[green]📄 Loaded {len(pages)} pages from {Path(file_path).name}[/green]")
    return pages

# %%
# Read DOCX with python-docx
from docx import Document

def load_docx(file_path: str) -> List[Dict]:
    """โหลด DOCX และ return paragraphs"""
    doc = Document(file_path)
    paragraphs = []
    
    current_section = ""
    for i, para in enumerate(doc.paragraphs):
        text = para.text.strip()
        if not text:
            continue
        
        # Detect headings
        if para.style.name.startswith("Heading"):
            current_section = text
        
        paragraphs.append({
            "index": i,
            "text": text,
            "section": current_section,
            "source": Path(file_path).name
        })
    
    rprint(f"[green]📄 Loaded {len(paragraphs)} paragraphs from {Path(file_path).name}[/green]")
    return paragraphs

